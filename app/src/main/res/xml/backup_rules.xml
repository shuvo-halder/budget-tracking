<?xml version="1.0" encoding="utf-8"?>
<!--
   Full Backup Rules for Android 6.0 to Android 11 (API 23 to 30).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- SEC-001: Exclude sensitive Room SQLite database files from OS Auto-Backup -->
    <exclude domain="database" path="." />
    <!-- SEC-001: Exclude DataStore preferences from OS Auto-Backup -->
    <exclude domain="file" path="datastore" />
    <!-- SEC-001: Exclude SharedPreferences from OS Auto-Backup -->
    <exclude domain="sharedpref" path="." />
</full-backup-content>
